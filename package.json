{
  "name": "joanna",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n web,api -c cyan,magenta \"npm run dev:web\" \"npm run dev:server\"",
    "dev:web": "vite",
    "dev:server": "node --watch server/src/index.js",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "npm run build && node scripts/spa-github-pages.mjs && gh-pages -d dist --dotfiles",
    "start:server": "node server/src/index.js",
    "test:unit": "vitest",
    "lint": "run-s \"lint:*\"",
    "lint:oxlint": "oxlint . --fix",
    "lint:eslint": "eslint . --fix --cache",
    "format": "prettier --write --experimental-cli src/"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "d3-geo": "^3.1.1",
    "express": "^5.2.1",
    "multer": "^2.4.0",
    "pinia": "^4.0.3",
    "topojson-client": "^3.1.0",
    "vue": "^3.5.42",
    "vue-router": "^5.3.1",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/eslint-plugin": "^1.6.27",
    "@vue/test-utils": "^2.5.0",
    "concurrently": "^10.0.5",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "~1.82.0",
    "eslint-plugin-vue": "~10.11.0",
    "gh-pages": "^6.3.0",
    "globals": "^17.12.0",
    "jsdom": "^30.0.1",
    "npm-run-all2": "^9.0.3",
    "oxlint": "~1.82.0",
    "prettier": "3.9.6",
    "vite": "^8.2.2",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vitest": "^4.1.11",
    "vue-eslint-parser": "^10.4.1",
    "world-countries": "^5.1.0"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  }
}
