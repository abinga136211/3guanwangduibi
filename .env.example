# 复制为 .env 后按需修改。本地开发可直接用下方默认值。
# 勿把真实生产密钥提交到 Git。

# ---------- 前端 ----------
# 开发：留空，走 Vite 代理到本机 API（/api → localhost:3001）
# 生产：若前后端不同域名，填 API 根地址，例如 https://api.example.com
VITE_API_BASE=

# ---------- 后端 ----------
# HTTP 监听端口
PORT=3001

# SQLite 文件绝对/相对路径；留空则用 server/data/adgpay.sqlite
SQLITE_PATH=

# 跨域来源。开发可留空。生产建议设为官网，例如 https://www.adgpay.com
CORS_ORIGIN=

# ---------- 管理后台（/admin/login，仅密码）----------
# 默认 123456；生产务必修改
ADMIN_PASSWORD=123456
# 可选：bcrypt 哈希。若填写，则忽略上面的 ADMIN_PASSWORD
ADMIN_PASSWORD_HASH=
