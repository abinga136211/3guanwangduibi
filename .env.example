# 复制为 .env 后按需修改。本地开发可直接用下方默认值。
# 勿把真实生产密钥提交到 Git。

# ---------- 前端 ----------
# 开发：留空，走 Vite 代理到本机 API（/api → localhost）
# 生产构建：见 .env.production（GitHub Pages → 外网 API）
VITE_API_BASE=

# ---------- 后端 ----------
# HTTP 监听端口（与 Cloudflare 隧道本地端口一致，例如 3003）
PORT=3003

# SQLite 文件绝对/相对路径；留空则用 server/data/adgpay.sqlite
SQLITE_PATH=

# 跨域来源。GitHub Pages 示例：
# CORS_ORIGIN=https://abinga136211.github.io
# 留空则回显请求 Origin（开发/临时隧道可用）
CORS_ORIGIN=

# 前后端不同站时设为 none（配合 Secure Cookie）；主要鉴权仍建议用 Bearer token
# COOKIE_SAMESITE=none

# ---------- 管理后台（/admin/login，仅密码）----------
# 默认 123456；生产务必修改
ADMIN_PASSWORD=123456
# 可选：bcrypt 哈希。若填写，则忽略上面的 ADMIN_PASSWORD
ADMIN_PASSWORD_HASH=
